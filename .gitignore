<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Central de Apps — Auditoria &amp; Conferência — Grupo A</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  :root {
    --bg:#f5f6f8; --surface:#ffffff; --border:#e2e5eb; --text:#1a1f2b; --muted:#697086;
    --navy:#12213d; --navy2:#1c3560; --accent:#2563eb;
  }
  html, body { height:100%; }
  body { font-family:'Segoe UI',Calibri,system-ui,sans-serif; background:var(--bg); color:var(--text); }

  /* ── TOPBAR (sempre visível) ── */
  #topbar {
    position:sticky; top:0; z-index:100; height:56px; flex-shrink:0;
    background:linear-gradient(135deg,var(--navy) 0%,var(--navy2) 100%); color:#fff;
    display:flex; align-items:center; gap:10px; padding:0 14px;
    box-shadow:0 2px 10px rgba(0,0,0,.18);
  }
  .tb-brand { font-weight:800; font-size:14px; white-space:nowrap; flex-shrink:0; display:flex; align-items:center; gap:6px; }
  .tb-logo { height:38px; width:38px; border-radius:50%; object-fit:cover; display:block; flex-shrink:0; }
  .tb-tabs { display:flex; gap:2px; overflow:hidden; flex:1 1 auto; min-width:0; height:100%; align-items:center; }
  .ttab {
    background:transparent; border:none; color:#b7c2d9; cursor:pointer; font-size:26px; padding:8px;
    border-radius:10px; display:flex; align-items:center; justify-content:center; font-family:inherit;
    flex:0 0 auto; width:52px; height:52px; overflow:hidden; transition:.15s;
  }
  .ttab:hover { background:rgba(255,255,255,.14); transform:translateY(-1px); }
  .ttab.active { background:#fff; color:var(--navy); font-weight:700; box-shadow:0 3px 10px rgba(0,0,0,.18); }
  .ttab span:first-child { flex-shrink:0; }
  .ttab-label { display:none; }
  #ttab-home { width:52px; }
  .tb-right { display:flex; gap:6px; flex-shrink:0; }
  .tbtn {
    background:rgba(255,255,255,.12); border:none; color:#fff; cursor:pointer; font-size:12px; padding:8px 12px;
    border-radius:8px; font-family:inherit; white-space:nowrap;
  }
  .tbtn:hover:not(:disabled) { background:rgba(255,255,255,.26); }
  .tbtn:disabled { opacity:.3; cursor:not-allowed; }

  /* ── CONTENT ── */
  #content { height:calc(100vh - 56px); position:relative; overflow:hidden; }

  /* Home grid */
  #homeView { height:100%; overflow-y:auto; }
  .home-header { position:relative; padding:70px 40px; text-align:center; background:linear-gradient(180deg,rgba(10,20,35,.35),rgba(10,20,35,.72)), url(data:image/jpeg;base64,) center/cover no-repeat; }
  .home-header h1 { font-size:28px; font-weight:800; letter-spacing:.3px; margin-bottom:8px; color:#fff; text-shadow:0 2px 8px rgba(0,0,0,.35); }
  .home-header p { font-size:14px; color:#eaf1fb; max-width:680px; margin:0 auto; line-height:1.6; }
  .home-body { max-width:1180px; width:100%; margin:0 auto; padding:0 32px 50px; }
  .apps-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:20px; }
  .app-card {
    background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:22px;
    display:flex; flex-direction:column; gap:14px; transition:.18s;
    box-shadow:0 2px 10px rgba(15,23,42,.05); border-top:4px solid var(--accent);
    position:relative; cursor:grab;
  }
  .app-card:hover { transform:translateY(-3px); box-shadow:0 10px 28px rgba(15,23,42,.12); }
  .app-card.dragging { opacity:.4; cursor:grabbing; }
  .app-card.drag-over { box-shadow:0 0 0 2px var(--accent) inset, 0 10px 28px rgba(15,23,42,.12); }
  .app-card-drag { position:absolute; top:10px; right:12px; font-size:13px; color:var(--muted); opacity:.45; letter-spacing:1px; }
  .app-card:hover .app-card-drag { opacity:.8; }
  .app-card-icon { font-size:30px; width:52px; height:52px; flex-shrink:0; background:var(--accent); border-radius:12px;
    display:flex; align-items:center; justify-content:center; color:#fff; opacity:.92; cursor:pointer; }
  .app-card-body { flex:1; min-width:0; cursor:pointer; }
  .app-card-name { font-size:15px; font-weight:700; color:var(--text); margin-bottom:6px; line-height:1.3; }
  .app-card-desc { font-size:12.5px; color:var(--muted); line-height:1.55; }
  .app-card-actions { display:flex; gap:8px; margin-top:2px; }
  .app-card-open, .app-card-ppt {
    flex:1; border:none; border-radius:9px; padding:9px 10px; font-size:12px; font-weight:700; cursor:pointer;
    font-family:inherit; transition:.15s;
  }
  .app-card-open { background:var(--accent); color:#fff; }
  .app-card-open:hover { opacity:.88; }
  .app-card-ppt { background:#fff4e5; color:#b45309; border:1px solid #fde3b0; }
  .app-card-ppt:hover { background:#fde3b0; }
  .app-card-rename { flex:0 0 auto; border:1px solid var(--border); border-radius:9px; padding:9px 11px; font-size:12px;
    font-weight:700; cursor:pointer; font-family:inherit; transition:.15s; background:#fff; color:var(--muted); }
  .app-card-rename:hover { background:#f1f2f5; color:var(--text); }
  .home-footer { text-align:center; padding:20px; font-size:11.5px; color:var(--muted); }

  /* App viewer */
  #frameWrap { height:100%; position:relative; background:#fff; display:none; }
  #frameWrap iframe { position:absolute; inset:0; width:100%; height:100%; border:none; display:none; background:#fff; }
  #frameWrap iframe.active { display:block; }

  /* Ajuda */
  #ajudaView { display:none; height:100%; overflow-y:auto; }
  .ajuda-body { max-width:900px; margin:0 auto; padding:36px 32px 60px; }
  .ajuda-body h1 { font-size:24px; color:var(--text); margin-bottom:8px; }
  .ajuda-body > p { color:var(--muted); font-size:13.5px; margin-bottom:28px; }
  .ajuda-card { background:var(--surface); border:1px solid var(--border); border-top:4px solid var(--accent); border-radius:14px; padding:22px 24px; margin-bottom:18px; }
  .ajuda-card h3 { font-size:16px; color:var(--text); margin-bottom:12px; display:flex; align-items:center; gap:10px; }
  .ajuda-icon { font-size:20px; }
  .ajuda-card p { font-size:13px; color:#334155; line-height:1.6; margin-bottom:8px; }
  .ajuda-card ul { margin:6px 0 10px 22px; }
  .ajuda-card li { font-size:12.5px; color:#475569; line-height:1.7; }
  .ajuda-open { margin-top:6px; border:none; background:var(--accent); color:#fff; font-weight:700; font-size:12px;
    padding:8px 16px; border-radius:8px; cursor:pointer; font-family:inherit; }
  .ajuda-open:hover { opacity:.88; }

  @media (max-width:720px) {
    .home-header { padding:28px 18px 24px; }
    .home-header h1 { font-size:21px; }
  }
</style>
</head>
<body>

<!-- ═══ TOPBAR (fixa, sempre com todos os apps) ═══ -->
<div id="topbar">
  <div class="tb-brand"><img class="tb-logo" alt="Diroma" src="data:image/png;base64,"></div>
  <div class="tb-tabs" id="tbTabs">
    <button class="ttab active" id="ttab-home" onclick="showHome()" title="Início"><span>🏢</span><span class="ttab-label">Início</span></button>
    <button class="ttab" id="ttab-razao-dre" onclick="openApp('razao-dre')" title="Conferência"><span>📒</span><span class="ttab-label">Conferência</span></button><button class="ttab" id="ttab-almoxarifado" onclick="openApp('almoxarifado')" title="Análise de Almoxarifado"><span>📦</span><span class="ttab-label">Análise de Almoxarifado</span></button>  </div>
  <div class="tb-right">
    <button class="tbtn" id="btnAjuda" onclick="showAjuda()" title="O que cada app faz">❓ Ajuda</button>
    <button class="tbtn" id="btnPpt" onclick="downloadPptx(currentId)" title="Baixar a apresentação (PowerPoint) do app atual" disabled>📊 Apresentação</button>
    <button class="tbtn" id="btnNewTab" onclick="openInNewTab()" title="Abrir o app atual em uma nova aba" disabled>🗗 Nova aba</button>
  </div>
</div>

<!-- ═══ CONTENT ═══ -->
<div id="content">
  <div id="homeView">
    <div class="home-header">
      <h1>Bem-vindo</h1>
      <p>Sete ferramentas independentes de auditoria e conferência contábil — cada uma roda isolada, sem interferir nas demais. Clique num app na barra acima ou num card abaixo para abrir. Baixe a apresentação em PowerPoint correspondente a qualquer momento.</p>
    </div>
    <div class="home-body">
      <div class="apps-grid">
        
    
    <div class="app-card" style="--accent:#0F1C2E" data-app-id="razao-dre">
      <div class="app-card-drag">⠿⠿</div>
      <div class="app-card-icon" onclick="openApp('razao-dre')">📒</div>
      <div class="app-card-body" onclick="openApp('razao-dre')">
        <div class="app-card-name">Conferência</div>
        <div class="app-card-desc">Classifica despesas do razão em DRE (custo fixo/variável), audita fornecedores recorrentes e acompanha o Painel RDO.</div>
      </div>
      <div class="app-card-actions">
        <button class="app-card-open" onclick="openApp('razao-dre')">Abrir →</button>
        <button class="app-card-ppt" onclick="event.stopPropagation(); downloadPptx('razao-dre')" title="Baixar apresentação (PowerPoint)">📊 Apresentação</button>
        <button class="app-card-rename" onclick="event.stopPropagation(); renameApp('razao-dre')" title="Renomear para identificar melhor">✎</button>
      </div>
    </div>
    <div class="app-card" style="--accent:#1A365D" data-app-id="almoxarifado">
      <div class="app-card-drag">⠿⠿</div>
      <div class="app-card-icon" onclick="openApp('almoxarifado')">📦</div>
      <div class="app-card-body" onclick="openApp('almoxarifado')">
        <div class="app-card-name">Análise de Almoxarifado</div>
        <div class="app-card-desc">15 relatórios de estoque a partir do extrato de movimentação de itens: consumo, rotatividade, Curva ABC, custo de estoque.</div>
      </div>
      <div class="app-card-actions">
        <button class="app-card-open" onclick="openApp('almoxarifado')">Abrir →</button>
        <button class="app-card-ppt" onclick="event.stopPropagation(); downloadPptx('almoxarifado')" title="Baixar apresentação (PowerPoint)">📊 Apresentação</button>
        <button class="app-card-rename" onclick="event.stopPropagation(); renameApp('almoxarifado')" title="Renomear para identificar melhor">✎</button>
      </div>
    </div>
    
    
      </div>
    </div>
    <div class="home-footer">Todos os dados são processados localmente no seu navegador. Nenhuma informação é enviada para fora desta página. Nenhum app depende de internet para funcionar.</div>
  </div>

  <div id="ajudaView">
    <div class="ajuda-body">
      <h1>❓ Ajuda — O que cada app faz</h1>
      <p>Objetivo, principais funcionalidades e quando usar cada uma das sete ferramentas.</p>
      
    
    <div class="ajuda-card" style="--accent:#0F1C2E">
      <h3><span class="ajuda-icon">📒</span>Conferência</h3>
      <p><strong>Objetivo:</strong> Classifica as despesas do Razão Analítico numa DRE completa (Custo Fixo/Variável, Comissões, Folha), confronta fornecedores recorrentes esperados e acompanha o caixa diário de um hotel/pousada (Painel RDO).</p>
      <p><strong>Funcionalidades:</strong></p>
      <ul><li>Classificação de contas/lançamentos em categorias de DRE (aprendizado por regra)</li><li>DRE de Despesas em 3 visões: Mensal, Anual e Comparativo</li><li>Fornecedores Recorrentes: alerta quando um gasto esperado não aparece no mês</li><li>Painel RDO: Cartões, Clientes, Pendente, PIX, Antecipação de Reservas, Caixa — saldo dia a dia</li><li>Exporta Excel com 5 abas (DRE Mensal, Comparativo Anual, Consolidado, Resumo, Fornecedores Fixos) e PDF</li></ul>
      <p><strong>Quando usar:</strong> Fechamento de despesas do mês, montagem da DRE gerencial, controle diário de caixa/recebíveis em hotelaria.</p>
      <button class="ajuda-open" onclick="openApp('razao-dre')">Abrir este app →</button>
    </div>
    <div class="ajuda-card" style="--accent:#1A365D">
      <h3><span class="ajuda-icon">📦</span>Análise de Almoxarifado</h3>
      <p><strong>Objetivo:</strong> Importa o extrato de movimentação de itens do almoxarifado (entradas/saídas por produto) e gera 15 análises gerenciais de estoque — não é uma conferência de duas fontes, e sim um BI completo sobre um único extrato.</p>
      <p><strong>Funcionalidades:</strong></p>
      <ul><li>Rankings de consumo e de valor financeiro movimentado</li><li>Rotatividade de estoque e Saldo Atual (status OK/Crítico/Sem estoque)</li><li>Centros de Custo e Fornecedores mais relevantes</li><li>Detecção automática de Problemas (ruptura, excesso de estoque, consumo anormal) e Sugestões</li><li>Curva ABC, Custo de Estoque e relatórios de Movimentação (mensal/anual/comparativo)</li></ul>
      <p><strong>Quando usar:</strong> Controle de estoque e almoxarifado, priorização de compras, identificação de capital parado ou risco de ruptura.</p>
      <button class="ajuda-open" onclick="openApp('almoxarifado')">Abrir este app →</button>
    </div>
    
    
    </div>
  </div>

  <div id="frameWrap"></div>
</div>

<!-- ═══ EMBEDDED APP SOURCES (base64) ═══ -->
  <script type="text/plain" id="src-razao-dre"></script>
<script type="text/plain" id="src-almoxarifado"></script>


<!-- ═══ EMBEDDED PRESENTATIONS (base64) ═══ -->
<script type="text/plain" id="ppt-razao-dre"></script>
<script type="text/plain" id="ppt-almoxarifado"></script>




<script>
  const APPS = [{"id": "razao-dre", "name": "Conferência", "icon": "📒", "pptxName": "Conferencia do Razao x rdo x Despesas Fixa.pptx"}, {"id": "almoxarifado", "name": "Análise de Almoxarifado", "icon": "📦", "pptxName": "Conferencia Extrato de Movimentacao de Itens.pptx"}];
  const loaded = {};   // id -> { url, iframe }
  let currentId = null;

  function b64ToUtf8(b64) {
    const binary = atob(b64);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return new TextDecoder('utf-8').decode(bytes);
  }

  function downloadPptx(id) {
    if (!id) { alert('Abra um app primeiro para baixar sua apresentação.'); return; }
    const el = document.getElementById('ppt-' + id);
    if (!el) return;
    const app = APPS.find(a => a.id === id);
    const b64 = el.textContent;
    const mime = 'application/vnd.openxmlformats-officedocument.presentationml.presentation';
    const blob = new Blob([Uint8Array.from(atob(b64), c => c.charCodeAt(0))], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = (app && app.pptxName) || (id + '.pptx');
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 4000);
  }

  function ensureLoaded(id) {
    if (loaded[id]) return loaded[id];
    const b64 = document.getElementById('src-' + id).textContent;
    const html = b64ToUtf8(b64);
    const iframe = document.createElement('iframe');
    iframe.setAttribute('title', id);
    iframe.srcdoc = html;
    document.getElementById('frameWrap').appendChild(iframe);
    loaded[id] = { html, iframe };
    return loaded[id];
  }

  function setActiveTab(id) {
    document.querySelectorAll('.ttab').forEach(b => b.classList.remove('active'));
    const tab = id ? document.getElementById('ttab-' + id) : document.getElementById('ttab-home');
    if (tab) tab.classList.add('active');
  }

  function hideAllViews() {
    document.getElementById('homeView').style.display = 'none';
    document.getElementById('ajudaView').style.display = 'none';
    document.getElementById('frameWrap').style.display = 'none';
  }

  function openApp(id) {
    hideAllViews();
    document.getElementById('frameWrap').style.display = 'block';

    const entry = ensureLoaded(id);
    Object.values(loaded).forEach(e => e.iframe.classList.remove('active'));
    entry.iframe.classList.add('active');
    currentId = id;
    setActiveTab(id);

    document.getElementById('btnPpt').disabled = false;
    document.getElementById('btnNewTab').disabled = false;
  }

  function showHome() {
    hideAllViews();
    document.getElementById('homeView').style.display = 'block';
    currentId = null;
    setActiveTab(null);
    document.getElementById('btnPpt').disabled = true;
    document.getElementById('btnNewTab').disabled = true;
  }

  function showAjuda() {
    hideAllViews();
    document.getElementById('ajudaView').style.display = 'block';
    currentId = null;
    setActiveTab(null);
    document.getElementById('btnPpt').disabled = true;
    document.getElementById('btnNewTab').disabled = true;
  }

  function openInNewTab() {
    if (!currentId || !loaded[currentId]) return;
    const win = window.open('', '_blank');
    if (!win) return;
    win.document.open();
    win.document.write(loaded[currentId].html);
    win.document.close();
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && currentId) showHome();
  });

  // ═══ Renomear apps para identificação própria ═══
  const NAMES_KEY = 'central_apps_names';

  function getSavedNames() {
    try { return JSON.parse(localStorage.getItem(NAMES_KEY)) || {}; } catch (e) { return {}; }
  }

  function saveAppName(id, name) {
    const names = getSavedNames();
    if (name) names[id] = name; else delete names[id];
    try { localStorage.setItem(NAMES_KEY, JSON.stringify(names)); } catch (e) {}
  }

  function setAppDisplayName(id, name) {
    const cardName = document.querySelector('.app-card[data-app-id="' + id + '"] .app-card-name');
    if (cardName) cardName.textContent = name;
    const tab = document.getElementById('ttab-' + id);
    if (tab) {
      tab.title = name;
      const label = tab.querySelector('.ttab-label');
      if (label) label.textContent = name;
    }
  }

  function applySavedNames() {
    const names = getSavedNames();
    Object.keys(names).forEach(id => setAppDisplayName(id, names[id]));
  }

  function renameApp(id) {
    const app = APPS.find(a => a.id === id);
    const atual = getSavedNames()[id] || (app ? app.name : '');
    const novo = prompt('Novo nome para identificar este app:', atual);
    if (novo === null) return;
    const nome = novo.trim();
    saveAppName(id, nome || null);
    setAppDisplayName(id, nome || (app ? app.name : id));
  }

  // ═══ Reordenar apps por arrastar-e-soltar ═══
  const ORDER_KEY = 'central_apps_order';

  function reorderTabsToMatch(order) {
    const tabsWrap = document.getElementById('tbTabs');
    order.forEach(id => {
      const tab = document.getElementById('ttab-' + id);
      if (tab) tabsWrap.appendChild(tab);
    });
  }

  function saveAppsOrder() {
    const order = Array.from(document.querySelectorAll('.apps-grid .app-card')).map(c => c.dataset.appId);
    try { localStorage.setItem(ORDER_KEY, JSON.stringify(order)); } catch (e) {}
    reorderTabsToMatch(order);
  }

  function applySavedOrder() {
    let order;
    try { order = JSON.parse(localStorage.getItem(ORDER_KEY)); } catch (e) { order = null; }
    if (!Array.isArray(order) || !order.length) return;
    const grid = document.querySelector('.apps-grid');
    order.forEach(id => {
      const card = grid.querySelector('.app-card[data-app-id="' + id + '"]');
      if (card) grid.appendChild(card);
    });
    reorderTabsToMatch(order);
  }

  function initDragReorder() {
    const grid = document.querySelector('.apps-grid');
    if (!grid) return;
    let dragEl = null;

    grid.querySelectorAll('.app-card').forEach(card => {
      card.setAttribute('draggable', 'true');

      card.addEventListener('dragstart', () => {
        dragEl = card;
        card.classList.add('dragging');
      });

      card.addEventListener('dragend', () => {
        card.classList.remove('dragging');
        grid.querySelectorAll('.app-card').forEach(c => c.classList.remove('drag-over'));
        saveAppsOrder();
      });

      card.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (!dragEl || card === dragEl) return;
        grid.querySelectorAll('.app-card').forEach(c => c.classList.remove('drag-over'));
        card.classList.add('drag-over');
        const rect = card.getBoundingClientRect();
        const before = (e.clientX - rect.left) < rect.width / 2;
        grid.insertBefore(dragEl, before ? card : card.nextSibling);
      });
    });
  }

  applySavedOrder();
  initDragReorder();
  applySavedNames();
</script>

</body>
</html>
